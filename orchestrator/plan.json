      "schedule_days": 7
    },
    "entity-attribution.attribution": {
      "skill": "agents/entity-attribution/stages/attribution/SKILL.md",
      "needs": [{"contract": "profile", "max_age_days": 14}],
      "produces": ["attribution"],
      "schedule_days": 1
    }
  }
