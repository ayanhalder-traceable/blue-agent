    "attribution": {"version": "4", "validate": ["python3", "contracts/validate_attribution.py", "{path}"]}
  },
  "nodes": {
    "entity-attribution.profile": {
      "skill": "agents/entity-attribution/stages/profile/SKILL.md",
      "needs": [],
